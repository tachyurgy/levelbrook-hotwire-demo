<%# Replaced with a fresh copy after each submit so the textarea clears. %>
<%= turbo_frame_tag "new_question" do %>
  <%= form_with url: ballot_room_questions_path(room), scope: :question, method: :post, class: "rounded-xl border hairline bg-[var(--color-surface)] p-3" do |f| %>
    <%= f.text_area :body, rows: 2, required: true,
          placeholder: "Ask the room a question…",
          class: "field-input resize-none text-sm" %>
    <div class="mt-2 flex items-center justify-between">
      <span class="font-mono text-[10px] text-[var(--color-ink-faint)]">posting as <%= current_member&.name || "Guest" %></span>
      <%= f.submit "Ask", class: "btn btn-accent" %>
    </div>
  <% end %>
<% end %>
