<% total = poll.total_votes %>
<div class="rounded-xl border hairline bg-[var(--color-surface)] p-5"
     data-controller="poll"
     data-poll-id-value="<%= poll.id %>"
     data-poll-vote-url-value="<%= ballot_room_poll_votes_path(room, poll) %>">
  <div class="flex items-start justify-between gap-3">
    <div>
      <% if poll.ai_generated %>
        <span class="inline-flex items-center gap-1 rounded-full border hairline px-2 py-0.5 font-mono text-[10px] uppercase tracking-wide text-[var(--color-accent)]">✨ AI options<% if poll.asker.present? %> · <%= poll.asker %><% end %></span>
      <% end %>
      <h2 class="<%= "mt-1.5 " if poll.ai_generated %>font-display text-lg font-bold tracking-tight"><%= poll.question %></h2>
    </div>
    <span class="shrink-0 font-mono text-[11px] text-[var(--color-ink-faint)] tabular-nums"><span data-poll-target="total"><%= total %></span> votes</span>
  </div>

  <div class="mt-4 space-y-2">
    <% poll.options.each do |option| %>
      <% pct = option.share(total) %>
      <button type="button" data-poll-target="option" data-option-id="<%= option.id %>"
              data-action="poll#vote"
              class="group relative block w-full overflow-hidden rounded-lg border hairline px-3 py-2.5 text-left transition hover:border-[var(--color-accent)] disabled:cursor-default disabled:hover:border-[var(--color-hairline)]">
        <span data-bar class="absolute inset-y-0 left-0 bg-[var(--color-accent-soft)] transition-[width] duration-500 ease-out" style="width: <%= pct %>%"></span>
        <span class="relative flex items-center justify-between gap-3">
          <span class="text-sm font-medium"><%= option.label %></span>
          <span class="shrink-0 font-mono text-[11px] text-[var(--color-ink-faint)] tabular-nums">
            <span data-count><%= option.votes_count %></span> · <span data-pct><%= pct %>%</span>
          </span>
        </span>
      </button>
    <% end %>
  </div>
</div>
