<%# Ask a question -> Gemini writes the answer options -> it streams in as a live
    poll for everyone. Replaced with a fresh copy after each submit so the input
    clears. Local `error` (optional) surfaces a model/validation failure. %>
<%= turbo_frame_tag "new_poll" do %>
  <%= form_with url: ballot_room_polls_path(room), method: :post,
        class: "rounded-xl border hairline bg-[var(--color-surface)] p-4" do |f| %>
    <div class="flex items-center gap-2">
      <span class="text-base leading-none">✨</span>
      <p class="font-display text-sm font-bold tracking-tight">Ask anything — AI builds the poll</p>
    </div>
    <p class="mt-0.5 text-[12px] text-[var(--color-ink-soft)]">
      Type a question; Gemini drafts the answer options and it goes live for the whole room.
    </p>

    <div class="mt-3 flex flex-col gap-2 sm:flex-row">
      <%= f.text_field :question, required: true, autocomplete: "off",
            placeholder: "e.g. What should we tackle first next sprint?",
            class: "field-input flex-1 text-sm" %>
      <%= f.submit "Generate poll", class: "btn btn-accent shrink-0",
            data: { turbo_submits_with: "✨ Generating…" } %>
    </div>

    <% if local_assigns[:error].present? %>
      <p class="mt-2 font-mono text-[11px] text-red-600"><%= error %></p>
    <% end %>
  <% end %>
<% end %>
