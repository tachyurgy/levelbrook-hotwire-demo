<div id="<%= dom_id(question) %>"
     class="flex items-start gap-3 rounded-xl border hairline bg-[var(--color-surface)] p-3"
     data-controller="upvote"
     data-upvote-id-value="<%= question.id %>"
     data-upvote-url-value="<%= ballot_room_question_upvote_path(question.room, question) %>">
  <button type="button" data-action="upvote#cast"
          class="flex w-12 shrink-0 flex-col items-center rounded-lg border hairline py-1.5 text-[var(--color-ink-soft)] transition hover:border-[var(--color-accent)] hover:text-[var(--color-accent)] disabled:cursor-default disabled:opacity-60">
    <svg class="h-3.5 w-3.5" viewBox="0 0 16 16" fill="currentColor"><path d="M8 3l5 6H3z"/></svg>
    <span class="font-mono text-sm font-semibold tabular-nums" data-upvote-target="count"><%= question.upvotes_count %></span>
  </button>
  <div class="min-w-0">
    <p class="text-sm leading-snug text-[var(--color-ink)]"><%= question.body %></p>
    <p class="mt-1 font-mono text-[10px] text-[var(--color-ink-faint)]"><%= question.author %></p>
  </div>
</div>
