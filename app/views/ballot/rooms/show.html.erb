<% content_for :title, "#{@room.name} — Ballot" %>

<%# Subscribe so every vote / question morphs this page live for all viewers. %>
<%= turbo_stream_from @room %>

<div class="mx-auto max-w-5xl px-5 py-8">
  <div class="flex flex-wrap items-start justify-between gap-3">
    <div>
      <p class="eyebrow">Live room · broadcasts_refreshes morph</p>
      <h1 class="mt-1 font-display text-3xl font-extrabold tracking-tight"><%= @room.name %></h1>
      <p class="mt-1.5 text-sm text-[var(--color-ink-soft)]"><%= @room.subtitle %></p>
    </div>
    <%= button_to "Reset room", reset_ballot_room_path(@room), class: "btn btn-ghost", data: { turbo_confirm: "Reset this room to the seeded demo state?" } %>
  </div>

  <div class="mt-7 grid gap-6 lg:grid-cols-[1.3fr_1fr]">
    <%# --- Polls ----------------------------------------------------- %>
    <section class="space-y-5">
      <p class="eyebrow">Live polls</p>
      <%= render "ballot/rooms/new_poll", room: @room %>
      <% @polls.each do |poll| %>
        <%= render "ballot/rooms/poll", room: @room, poll: poll %>
      <% end %>
      <%= technique_caption "Ask a question and Gemini writes the answer options — the new poll streams onto every open browser via broadcasts_refreshes. Tap an option: your bar bumps optimistically, the server records the vote, and the exact tallies morph in. No charting library — bars are server-computed widths." %>
    </section>

    <%# --- Q&A ------------------------------------------------------- %>
    <section>
      <p class="eyebrow mb-3">Audience Q&A · upvote to re-sort</p>
      <%= render "ballot/rooms/new_question", room: @room %>

      <div id="<%= dom_id(@room, :questions) %>" class="mt-4 space-y-2.5">
        <% @questions.each do |question| %>
          <%= render "ballot/rooms/question", room: @room, question: question %>
        <% end %>
      </div>
      <%= technique_caption "Questions stream in and re-sort by upvotes via the same morph — order changes animate instead of jumping." %>
    </section>
  </div>
</div>
