<% content_for :title, "#{@scene.heading} — #{@story.title}" %>

<%# Subscribe to this scene's tally stream so the "% of readers chose this" %>
<%# bars update live as other readers make choices, without navigating us away. %>
<%= turbo_stream_from [ @story, @scene, :tally ] %>

<%#
  The scene wrapper carries a view-transition-name so the View Transitions API
  cross-fades the prose block between scenes. style scoping keeps it unique.
%>
<div class="min-h-[calc(100vh-7.5rem)] bg-gradient-to-b <%= mood_backdrop(@scene) %>">
  <article class="mx-auto max-w-2xl px-5 pb-40 pt-14" style="view-transition-name: scene">
    <p class="text-xs font-semibold uppercase tracking-[0.2em] text-orange-400/80"><%= @story.title %></p>
    <h1 class="mt-3 text-2xl font-bold leading-tight tracking-tight text-white sm:text-3xl">
      <%= @scene.heading %>
    </h1>

    <div class="prose-scene mt-6 space-y-4 text-[1.05rem] leading-relaxed text-slate-300">
      <% @scene.body.split(/\n\n+/).each do |para| %>
        <p><%= para.strip %></p>
      <% end %>
    </div>

    <% if @scene.ending? %>
      <%= render "scenes/ending", scene: @scene, story: @story %>
    <% else %>
      <div class="mt-10 space-y-3">
        <% @scene.choices.each do |choice| %>
          <%= render "scenes/choice", story: @story, choice: choice %>
        <% end %>
      </div>

      <%# Live tally, broadcast-updated. %>
      <%= render "stories/tally", scene: @scene %>
    <% end %>
  </article>
</div>

<%# Persistent ambient-audio + progress bar. Marked data-turbo-permanent so %>
<%# Turbo carries the SAME element across every scene navigation: the audio %>
<%# never restarts and the Stimulus controller's play state survives. %>
<%= render "stories/ambient_bar" %>
