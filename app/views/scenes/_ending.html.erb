<div class="mt-10 rounded-2xl border border-orange-500/20 bg-orange-500/[0.06] p-6">
  <p class="text-xs font-semibold uppercase tracking-[0.15em] text-orange-400">An ending</p>
  <p class="mt-1 text-lg font-bold text-white"><%= scene.ending_kind %></p>
  <div class="mt-5 flex flex-wrap gap-3">
    <%= link_to "Read it again", story_path(story),
          class: "rounded-lg bg-orange-500 px-4 py-2.5 text-sm font-semibold text-white transition hover:bg-orange-400" %>
    <%= link_to "Other stories", stories_path,
          class: "rounded-lg border border-white/10 bg-white/5 px-4 py-2.5 text-sm font-semibold text-slate-200 transition hover:bg-white/10" %>
  </div>
</div>
