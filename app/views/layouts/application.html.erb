<!DOCTYPE html>
<html lang="en" class="h-full">
  <head>
    <title><%= content_for(:title) || "Levelbrook · Hotwire Showcase" %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="application-name" content="Levelbrook Showcase">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <%# Hotwire 2026 defaults: navigations morph the DOM (preserving scroll/ %>
    <%# focus/permanent elements) and run inside a View Transition where supported. %>
    <meta name="turbo-refresh-method" content="morph">
    <meta name="turbo-refresh-scroll" content="preserve">
    <meta name="view-transition" content="same-origin">

    <%= yield :head %>

    <link rel="icon" href="/icon.svg" type="image/svg+xml">
    <link rel="apple-touch-icon" href="/icon.png">

    <%# Engineered Editorial typeface stack %>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Bricolage+Grotesque:opsz,wght@12..96,400;12..96,600;12..96,700;12..96,800&family=Inter+Tight:wght@400;500;600;700&family=JetBrains+Mono:wght@400;500;600&display=swap" rel="stylesheet">

    <%= stylesheet_link_tag :tailwind, "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
  </head>

  <body class="h-full antialiased">
    <% if current_app %>
      <%# Themeable product shell. The accent override re-skins every %>
      <%# var(--color-accent) usage in this app's views — one CSS custom %>
      <%# property, six products. %>
      <div class="flex min-h-full"
           style="--color-accent: <%= current_app.accent %>; --color-accent-soft: <%= current_app.accent_soft %>;">
        <%= render "shared/app_sidebar", app: current_app %>

        <div class="flex min-h-full min-w-0 flex-1 flex-col">
          <%= render "shared/app_topbar", app: current_app %>
          <main class="flex-1"><%= yield %></main>
        </div>
      </div>

      <%# Workspace-only chrome: the lazy issue-drawer frame + ⌘K palette. %>
      <% if current_app.key == :workspace %>
        <%= render "shared/modal" %>
        <%= render "shared/command_palette" %>
      <% end %>
    <% else %>
      <%# Gallery / standalone pages render chromeless. %>
      <%= yield %>
    <% end %>

    <%# Toast stack — Turbo Stream side-channel appends here from anywhere. %>
    <div id="toasts" class="pointer-events-none fixed bottom-5 right-5 z-50 flex w-80 flex-col gap-2"></div>
  </body>
</html>
