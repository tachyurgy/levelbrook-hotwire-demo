<!DOCTYPE html>
<html lang="en" class="h-full">
  <head>
    <title><%= content_for(:title) || "Levelbrook Workspace" %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="application-name" content="Levelbrook Workspace">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <%# Hotwire 2026 defaults: navigations morph the DOM (preserving scroll/ %>
    <%# focus/permanent elements) and run inside a View Transition where supported. %>
    <meta name="turbo-refresh-method" content="morph">
    <meta name="turbo-refresh-scroll" content="preserve">
    <meta name="view-transition" content="same-origin">

    <%= yield :head %>

    <link rel="icon" href="/icon.svg" type="image/svg+xml">
    <link rel="apple-touch-icon" href="/icon.png">

    <%# Engineered Editorial typeface stack %>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Bricolage+Grotesque:opsz,wght@12..96,400;12..96,600;12..96,700;12..96,800&family=Inter+Tight:wght@400;500;600;700&family=JetBrains+Mono:wght@400;500;600&display=swap" rel="stylesheet">

    <%= stylesheet_link_tag :tailwind, "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
  </head>

  <body class="h-full antialiased">
    <%# Product-workspace shell: persistent left rail + topbar + scrolling main. %>
    <div class="flex min-h-full">
      <%= render "shared/sidebar" %>

      <div class="flex min-h-full min-w-0 flex-1 flex-col">
        <%= render "shared/topbar" %>

        <main class="flex-1">
          <%= yield %>
        </main>
      </div>
    </div>

    <%# Toast stack — Turbo Stream side-channel appends here from anywhere. %>
    <div id="toasts" class="pointer-events-none fixed bottom-20 right-5 z-50 flex w-80 flex-col gap-2"></div>

    <%# Lazy Turbo Frame modal — links with data-turbo-frame="modal" render here. %>
    <%= render "shared/modal" %>

    <%# ⌘K command palette overlay. %>
    <%= render "shared/command_palette" %>

    <%# Persistent media player. Lives in the layout, is permanent across all %>
    <%# Turbo navigations, and never re-mounts — so playback never cuts out. %>
    <%= render "shared/player" %>
  </body>
</html>
