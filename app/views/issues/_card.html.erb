<%# Compact issue card. Draggable (SortableJS) and clickable (opens the lazy %>
<%# Turbo Frame modal). data-position-url is the PUT target on drop. %>
<% label_palette = {
     "emerald" => "bg-emerald-50 text-emerald-700 ring-emerald-200",
     "rose"    => "bg-rose-50 text-rose-700 ring-rose-200",
     "slate"   => "bg-gray-50 text-gray-600 ring-gray-200",
     "violet"  => "bg-violet-50 text-violet-700 ring-violet-200"
   } %>
<%= link_to issue_path(issue),
      id: dom_id(issue),
      data: { turbo_frame: "modal", position_url: issue_position_path(issue), turbo_action: "advance" },
      class: "group block cursor-grab rounded-lg border hairline bg-[var(--color-surface)] p-3 shadow-sm transition hover:border-[var(--color-cool-300)] hover:shadow active:cursor-grabbing",
      style: "view-transition-name: #{dom_id(issue)}" do %>
  <div class="mb-1.5 flex items-center gap-2">
    <span class="rounded px-1.5 py-0.5 text-[10px] font-medium uppercase tracking-wide ring-1 ring-inset <%= label_palette.fetch(issue.label_color, label_palette['slate']) %>"><%= issue.label %></span>
    <%= priority_icon issue.priority %>
  </div>

  <p class="text-sm font-medium leading-snug text-[var(--color-ink)] group-hover:text-[var(--color-accent)]"><%= issue.title %></p>

  <div class="mt-3 flex items-center justify-between">
    <span class="issue-key"><%= issue.key %></span>
    <div class="flex items-center gap-2">
      <% if issue.points.to_i > 0 %>
        <span class="grid h-5 min-w-5 place-items-center rounded bg-[var(--color-cool-100)] px-1 font-mono text-[11px] font-medium text-[var(--color-cool-700)]"><%= issue.points %></span>
      <% end %>
      <%= render "shared/avatar", member: issue.assignee, size: :sm %>
    </div>
  </div>
<% end %>
