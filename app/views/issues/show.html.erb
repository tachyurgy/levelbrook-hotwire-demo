<%# Rendered into the layout's lazy "modal" Turbo Frame when a card is clicked. %>
<%= turbo_frame_tag "modal" do %>
  <%# Subscribe so streamed comments append live for everyone with it open. %>
  <%= turbo_stream_from @issue %>

  <div class="flex max-h-[80vh] flex-col">
    <header class="flex items-center justify-between border-b hairline px-5 py-3.5">
      <div class="flex items-center gap-2">
        <span class="issue-key rounded bg-[var(--color-cool-100)] px-1.5 py-0.5 text-[var(--color-cool-700)]"><%= @issue.key %></span>
        <span class="font-mono text-[11px] text-[var(--color-ink-faint)]">in <%= @issue.column.project.name %></span>
      </div>
      <button type="button" data-action="modal#close" class="grid h-7 w-7 place-items-center rounded-md text-[var(--color-ink-faint)] transition hover:bg-[var(--color-cool-100)] hover:text-[var(--color-ink)]" aria-label="Close">
        <svg class="h-4 w-4" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.6"><path d="m4 4 8 8M12 4l-8 8"/></svg>
      </button>
    </header>

    <div class="flex-1 overflow-y-auto px-5 py-4">
      <div class="grid gap-5 md:grid-cols-[1fr_180px]">
        <%# --- main column: title, description, comments --- %>
        <div class="min-w-0 space-y-5">
          <%= render "issues/fields/title", issue: @issue %>
          <%= render "issues/fields/description", issue: @issue %>

          <div>
            <p class="eyebrow mb-2">Comments</p>
            <div id="<%= dom_id(@issue, :comments) %>" class="space-y-2.5">
              <% @issue.comments.each do |comment| %>
                <%= render "comments/comment", comment: comment %>
              <% end %>
            </div>
            <div class="mt-3">
              <%= render "comments/form", issue: @issue %>
            </div>
            <%= technique_caption "Comments append via Turbo Stream (broadcast_append_to) — live for everyone viewing this issue." %>
          </div>
        </div>

        <%# --- sidebar: status, assignee, meta --- %>
        <aside class="space-y-4 md:border-l md:hairline md:pl-5">
          <div>
            <p class="eyebrow mb-1.5">Status</p>
            <%= render "issues/fields/status", issue: @issue %>
          </div>
          <div>
            <p class="eyebrow mb-1.5">Assignee</p>
            <%= render "issues/fields/assignee", issue: @issue %>
          </div>
          <div>
            <p class="eyebrow mb-1.5">Priority</p>
            <div class="flex items-center gap-2"><%= priority_icon @issue.priority %><span class="text-sm capitalize"><%= @issue.priority %></span></div>
          </div>
          <div>
            <p class="eyebrow mb-1.5">Points</p>
            <span class="font-mono text-sm"><%= @issue.points %></span>
          </div>
          <%= technique_caption "Each field is its own Turbo Frame — click to swap in an edit form, no modal-within-modal, no JS state." %>
        </aside>
      </div>
    </div>
  </div>
<% end %>
