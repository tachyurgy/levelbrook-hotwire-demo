<% content_for :title, "Levelbrook Workspace — a Hotwire showcase" %>

<section class="border-b hairline">
  <div class="mx-auto max-w-[1400px] px-5 py-16 md:py-24">
    <p class="eyebrow">A Hotwire showcase · Rails 8 · Turbo 8 morph · Stimulus · Action Cable</p>
    <h1 class="mt-3 max-w-3xl font-display text-5xl font-extrabold leading-[1.04] tracking-tight md:text-6xl">
      A team workspace built entirely with <span class="text-[var(--color-accent)]">HTML over the wire</span>.
    </h1>
    <p class="mt-5 max-w-2xl text-lg leading-relaxed text-[var(--color-ink-soft)]">
      Levelbrook is a Linear/Basecamp-lite workspace — a Jira-grade kanban board, real-time chat with
      presence, live search, inline editing, and a ⌘K palette. No SPA framework. No client state. Just
      Turbo, Stimulus, and one accent color.
    </p>
    <div class="mt-8 flex flex-wrap gap-3">
      <%= link_to "Open the board", project_path(Project.first), class: "btn btn-accent", data: { turbo_action: "advance" } %>
      <%= link_to "Open chat", channels_path, class: "btn btn-ghost", data: { turbo_action: "advance" } %>
      <button type="button" onclick="window.dispatchEvent(new CustomEvent('command-palette:open'))" class="btn btn-ghost">Try ⌘K</button>
    </div>
  </div>
</section>

<section class="mx-auto max-w-[1400px] px-5 py-14">
  <div class="mb-8 flex items-end justify-between">
    <h2 class="font-display text-2xl font-bold tracking-tight">Modules</h2>
    <p class="hidden font-mono text-xs text-[var(--color-ink-faint)] sm:block">each demonstrates a distinct Hotwire technique</p>
  </div>

  <div class="grid gap-px overflow-hidden rounded-xl border hairline bg-[var(--color-hairline)] sm:grid-cols-2 lg:grid-cols-3">
    <% modules = [
         ["Kanban board", "Drag a card; it moves in every connected window.", "SortableJS → PUT → broadcasts_refreshes → morph", project_path(Project.first)],
         ["Issue detail modal", "Click a card to open a lazy modal with inline edits + comments.", "Lazy Turbo Frame + frame-swap inline edit", project_path(Project.first)],
         ["Real-time chat", "Messages, presence, and typing indicators.", "broadcast_append_to + raw Action Cable", channels_path],
         ["Live search", "Type-ahead filtering with shareable URLs.", "Debounced frame + turbo-action advance", search_path],
         ["Activity feed", "Infinite scroll that just appears.", "Deferred lazy Turbo Frames", activities_path],
         ["Live validation", "Per-field errors on blur, server-rendered.", "Turbo Stream replace per field", new_signup_path],
         ["Command palette", "Global ⌘K with server-rendered results.", "Hotkeys + frame fetch + keyboard nav", nil],
         ["Toasts", "A streamed, auto-dismissing side-channel.", "turbo_stream.append from anywhere", nil],
         ["Persistent player", "Audio keeps playing across every navigation.", "data-turbo-permanent + Web Audio", nil]
       ] %>
    <% modules.each do |title, desc, technique, path| %>
      <% wrapper_attrs = path ? { tag: :a, href: path } : { tag: :div } %>
      <%= content_tag wrapper_attrs[:tag], href: wrapper_attrs[:href],
            data: (path ? { turbo_action: "advance" } : {}),
            class: "group block bg-[var(--color-surface)] p-6 transition hover:bg-[var(--color-cool-50)]" do %>
        <h3 class="font-display text-lg font-bold tracking-tight group-hover:text-[var(--color-accent)]"><%= title %></h3>
        <p class="mt-1.5 text-sm leading-relaxed text-[var(--color-ink-soft)]"><%= desc %></p>
        <p class="mt-4 font-mono text-[11px] leading-relaxed text-[var(--color-ink-faint)]"><%= technique %></p>
      <% end %>
    <% end %>
  </div>
</section>

<section class="mx-auto max-w-[1400px] px-5 pb-24">
  <div class="rounded-xl border hairline bg-[var(--color-surface)] p-6">
    <p class="eyebrow mb-3">The team</p>
    <div class="flex flex-wrap gap-4">
      <% @members.each do |m| %>
        <div class="flex items-center gap-2.5">
          <%= render "shared/avatar", member: m, size: :lg %>
          <div>
            <div class="text-sm font-semibold leading-tight"><%= m.name %></div>
            <div class="font-mono text-[11px] text-[var(--color-ink-faint)]"><%= m.role %></div>
          </div>
        </div>
      <% end %>
    </div>
  </div>
</section>
