<% content_for :title, "Levelbrook Workspace" %>
<% content_for :breadcrumb, "Dashboard" %>

<%# Subscribe to the primary board's refresh stream. Dragging a card on the %>
<%# snapshot below (or on the full board, or in another tab) broadcasts a %>
<%# refresh and Turbo morphs this dashboard — counts and all — in place. %>
<% if @primary %><%= turbo_stream_from @primary %><% end %>

<div class="mx-auto max-w-[1400px] px-5 py-8">

  <%# --- Header + quick actions --------------------------------------- %>
  <div class="flex flex-wrap items-end justify-between gap-4">
    <div>
      <p class="eyebrow">Delivery workspace</p>
      <h1 class="mt-1 font-display text-3xl font-extrabold tracking-tight">
        <%= @primary&.name || "Workspace" %> overview
      </h1>
      <p class="mt-1.5 text-sm text-[var(--color-ink-soft)]">
        <%= pluralize(@members.size, "engineer") %> · <%= pluralize(@projects.size, "project") %> —
        everything below is live, server-rendered data.
      </p>
    </div>
    <div class="flex flex-wrap gap-2">
      <% if @primary %>
        <%= link_to "Open board", project_path(@primary), class: "btn btn-accent", data: { turbo_action: "advance" } %>
      <% end %>
      <%= link_to "Activity", activities_path, class: "btn btn-ghost", data: { turbo_action: "advance" } %>
    </div>
  </div>

  <%# --- Metric tiles ------------------------------------------------- %>
  <div class="mt-6 grid grid-cols-2 gap-3 lg:grid-cols-4">
    <% tiles = [
         ["Open issues",   @issue_count,    "across all columns"],
         ["Story points",  @points_total,   "committed this board"],
         ["High priority", @high_priority,  "urgent + high"],
         ["Team",          @members.size,   "active members"]
       ] %>
    <% tiles.each do |label, value, sub| %>
      <div class="rounded-xl border hairline bg-[var(--color-surface)] p-4">
        <p class="eyebrow"><%= label %></p>
        <p class="mt-2 font-display text-3xl font-extrabold leading-none tracking-tight tabular-nums"><%= value %></p>
        <p class="mt-1.5 font-mono text-[11px] text-[var(--color-ink-faint)]"><%= sub %></p>
      </div>
    <% end %>
  </div>

  <%# --- Board snapshot + recent activity ----------------------------- %>
  <div class="mt-6 grid gap-4 lg:grid-cols-3">

    <%# Board snapshot — a LIVE mini-board, not a static preview. Each column is
        a real SortableJS drop zone holding the same draggable cards as the full
        board; dropping one PUTs its new position and broadcasts_refreshes morphs
        every connected view (this dashboard included). %>
    <div class="rounded-xl border hairline bg-[var(--color-surface)] lg:col-span-2">
      <div class="flex items-center justify-between border-b hairline px-5 py-3">
        <div class="flex items-baseline gap-2.5">
          <h2 class="font-display text-base font-bold tracking-tight">Board snapshot</h2>
          <span class="hidden font-mono text-[11px] text-[var(--color-ink-faint)] sm:inline">drag to reorder — it's live</span>
        </div>
        <% if @primary %>
          <%= link_to "Open #{@primary.key} →", project_path(@primary),
                class: "font-mono text-[11px] text-[var(--color-ink-faint)] hover:text-[var(--color-accent)]",
                data: { turbo_action: "advance" } %>
        <% end %>
      </div>
      <% if @primary %>
        <div class="grid gap-px overflow-hidden bg-[var(--color-hairline)] sm:grid-cols-2 xl:grid-cols-4">
          <% @primary.columns.each do |column| %>
            <div class="bg-[var(--color-surface)] p-3">
              <div class="flex items-center justify-between px-1">
                <span class="text-[13px] font-semibold"><%= column.name %></span>
                <span class="font-mono text-[11px] text-[var(--color-ink-faint)] tabular-nums"><%= column.issues.size %></span>
              </div>
              <div data-controller="sortable"
                   data-sortable-group-value="board"
                   data-column-id="<%= column.id %>"
                   class="column-cards mt-2 flex max-h-[22rem] min-h-16 flex-col gap-2 overflow-y-auto rounded-lg bg-[var(--color-cool-100)]/50 p-1.5">
                <% column.issues.each do |issue| %>
                  <%= render "issues/card", issue: issue %>
                <% end %>
                <% if column.issues.empty? %>
                  <p class="px-1 py-2 font-mono text-[11px] text-[var(--color-ink-faint)]">Drop a card here</p>
                <% end %>
              </div>
            </div>
          <% end %>
        </div>
      <% else %>
        <p class="p-5 text-sm text-[var(--color-ink-soft)]">No project yet.</p>
      <% end %>
    </div>

    <%# Recent activity (real) %>
    <div class="rounded-xl border hairline bg-[var(--color-surface)]">
      <div class="flex items-center justify-between border-b hairline px-5 py-3">
        <h2 class="font-display text-base font-bold tracking-tight">Recent activity</h2>
        <%= link_to "All →", activities_path,
              class: "font-mono text-[11px] text-[var(--color-ink-faint)] hover:text-[var(--color-accent)]",
              data: { turbo_action: "advance" } %>
      </div>
      <ul class="divide-y hairline">
        <% @recent.each do |item| %>
          <li class="flex items-start gap-3 px-5 py-3">
            <span class="mt-0.5 text-[var(--color-ink-faint)]"><%= ws_icon(item.icon == "issue" ? "board" : "chat", cls: "h-3.5 w-3.5") %></span>
            <div class="min-w-0">
              <p class="text-[13px] leading-snug">
                <span class="font-semibold"><%= item.actor %></span>
                <span class="text-[var(--color-ink-soft)]"><%= item.verb %></span>
                <span class="font-medium"><%= item.subject %></span>
              </p>
              <p class="mt-0.5 truncate font-mono text-[11px] text-[var(--color-ink-faint)]">
                <%= item.context %> · <%= time_ago_in_words(item.at) %> ago
              </p>
            </div>
          </li>
        <% end %>
      </ul>
    </div>
  </div>

  <%# --- Team strip --------------------------------------------------- %>
  <div class="mt-4 rounded-xl border hairline bg-[var(--color-surface)] px-5 py-4">
    <p class="eyebrow mb-3">The team</p>
    <div class="flex flex-wrap gap-x-6 gap-y-3">
      <% @members.each do |m| %>
        <div class="flex items-center gap-2.5">
          <%= render "shared/avatar", member: m, size: :md %>
          <div>
            <div class="text-sm font-semibold leading-tight"><%= m.name %></div>
            <div class="font-mono text-[10px] text-[var(--color-ink-faint)]"><%= m.role %></div>
          </div>
        </div>
      <% end %>
    </div>
  </div>

  <%# --- Proof strip: explain AFTER the working UI -------------------- %>
  <div class="mt-8 border-t hairline pt-5">
    <p class="eyebrow mb-3">How this workspace is built — open any feature, then read the technique</p>
    <div class="grid gap-px overflow-hidden rounded-xl border hairline bg-[var(--color-hairline)] sm:grid-cols-2 lg:grid-cols-3">
      <% proofs = [
           ["Kanban board", @primary ? project_path(@primary) : projects_path, "SortableJS → PUT → broadcasts_refreshes → Turbo morph; no custom broadcast code."],
           ["Issue drawer", @primary ? project_path(@primary) : projects_path, "Lazy Turbo Frame; /issues/:id still works as a full page. Frame-scoped inline edit."],
           ["Live search", search_path, "A normal form enhanced with a debounced submit; URL/history preserved."],
           ["Activity feed", activities_path, "Lazy Turbo Frames paginate real records — infinite scroll, almost no JS."],
           ["Intake form", new_signup_path, "Server-authoritative validation streamed per field; works with JS off."]
         ] %>
      <% proofs.each do |title, path, technique| %>
        <%= link_to path, data: { turbo_action: "advance" },
              class: "group block bg-[var(--color-surface)] p-4 transition hover:bg-[var(--color-cool-50)]" do %>
          <div class="flex items-center justify-between">
            <h3 class="text-[13px] font-bold tracking-tight group-hover:text-[var(--color-accent)]"><%= title %></h3>
            <span class="font-mono text-[11px] text-[var(--color-ink-faint)] transition group-hover:translate-x-0.5">→</span>
          </div>
          <p class="mt-1.5 font-mono text-[11px] leading-relaxed text-[var(--color-ink-faint)]"><%= technique %></p>
        <% end %>
      <% end %>
    </div>
  </div>
</div>
