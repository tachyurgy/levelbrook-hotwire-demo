<article id="<%= dom_id(card) %>"
         draggable="true"
         data-drag-and-drop-target="item"
         data-card-id="<%= card.id %>"
         class="group cursor-grab rounded-lg border border-white/10 bg-slate-900 p-3 shadow-sm transition hover:border-white/20 active:cursor-grabbing">
  <div class="flex items-start justify-between gap-2">
    <p class="text-sm font-medium leading-snug text-slate-100"><%= card.title %></p>
    <%= button_to card_path(card), method: :delete,
          class: "shrink-0 rounded p-0.5 text-slate-600 opacity-0 transition hover:text-rose-400 group-hover:opacity-100",
          form: { data: { turbo_confirm: "Delete this card?" } } do %>
      <span aria-hidden="true" class="text-xs">✕</span>
    <% end %>
  </div>

  <% if card.body.present? %>
    <p class="mt-1.5 text-xs leading-relaxed text-slate-400"><%= card.body %></p>
  <% end %>

  <div class="mt-2.5 flex items-center justify-between">
    <% if card.tag.present? %>
      <span class="rounded px-1.5 py-0.5 text-[10px] font-medium uppercase tracking-wide <%= tag_pill_class(card.tag) %>"><%= card.tag %></span>
    <% else %>
      <span></span>
    <% end %>
    <% if card.assignee.present? %>
      <span class="grid h-6 w-6 place-items-center rounded-full bg-white/10 text-[10px] font-semibold text-slate-300" title="<%= card.assignee %>">
        <%= card.assignee.first(2).upcase %>
      </span>
    <% end %>
  </div>
</article>
