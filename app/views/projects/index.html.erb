<% content_for :title, "Boards — Levelbrook" %>
<div class="mx-auto max-w-[1400px] px-5 py-10">
  <div class="mb-8">
    <p class="eyebrow">Kanban · SortableJS + broadcasts_refreshes + morph</p>
    <h1 class="font-display text-3xl font-bold tracking-tight">Boards</h1>
    <%= technique_caption "Drag a card in one window and it moves in every connected window — one broadcasts_refreshes line, idiomorph reconciles the DOM." %>
  </div>

  <div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
    <% @projects.each do |project| %>
      <%= link_to project_path(project), data: { turbo_action: "advance" },
            class: "group block rounded-xl border hairline bg-[var(--color-surface)] p-5 transition hover:border-[var(--color-ink)]" do %>
        <div class="flex items-center justify-between">
          <span class="issue-key rounded bg-[var(--color-cool-100)] px-1.5 py-0.5 text-[var(--color-cool-700)]"><%= project.key %></span>
          <span class="font-mono text-[11px] text-[var(--color-ink-faint)]"><%= project.issues.count %> issues</span>
        </div>
        <h2 class="mt-3 font-display text-xl font-bold tracking-tight group-hover:text-[var(--color-accent)]"><%= project.name %></h2>
        <p class="mt-1 text-sm text-[var(--color-ink-soft)]"><%= project.description %></p>
        <div class="mt-4 flex -space-x-1.5">
          <% project.issues.includes(:assignee).filter_map(&:assignee).uniq.first(5).each do |m| %>
            <%= render "shared/avatar", member: m, size: :sm %>
          <% end %>
        </div>
      <% end %>
    <% end %>
  </div>
</div>
