<% content_for :title, "Relay — live LLM streaming over the AI SDK protocol" %>

<%# Single-screen demo: the whole experience is frozen to the viewport height
    (no page scroll). Only the transcript and the wire inspector scroll, each
    inside its own panel. 3.5rem is the sticky topbar (h-14). %>
<div class="flex flex-col overflow-hidden px-4 py-4 sm:px-6"
     style="height: calc(100dvh - 3.5rem)"
     data-controller="ai-stream"
     data-ai-stream-url-value="<%= relay_messages_path %>">

  <%# --- Compact header ------------------------------------------------- %>
  <header class="flex shrink-0 flex-wrap items-center justify-between gap-x-4 gap-y-2 pb-3">
    <div class="min-w-0">
      <p class="eyebrow">ActionController::Live · ai_stream · Google Gemini</p>
      <h1 class="font-display text-xl font-extrabold leading-tight tracking-tight sm:text-2xl">
        A live LLM, streamed into Rails over the <span class="text-[var(--color-accent)]">AI SDK protocol</span>
      </h1>
    </div>
    <span class="inline-flex shrink-0 items-center gap-1.5 rounded-full border hairline bg-[var(--color-surface)] px-2.5 py-1 font-mono text-[11px] <%= @live ? "text-emerald-600" : "text-[var(--color-ink-faint)]" %>">
      <span class="h-1.5 w-1.5 rounded-full <%= @live ? "bg-emerald-500" : "bg-[var(--color-ink-faint)]" %>"></span>
      <%= @live ? "Gemini live" : "canned tokens (no key)" %>
    </span>
  </header>

  <%# --- Body: chat + wire inspector, filling the remaining height ------- %>
  <div class="grid min-h-0 flex-1 gap-4 lg:grid-cols-[1fr_1fr]">

    <%# --- Chat column ------------------------------------------------- %>
    <section class="flex min-h-0 min-w-0 flex-col overflow-hidden rounded-2xl border hairline bg-[var(--color-paper)]">
      <div data-ai-stream-target="transcript"
           class="min-h-0 flex-1 space-y-3 overflow-y-auto p-4">
        <div data-ai-stream-target="empty" class="grid h-full place-items-center text-center">
          <div class="max-w-xs">
            <span class="mx-auto grid h-10 w-10 place-items-center rounded-xl bg-[var(--color-accent)] font-display text-lg font-extrabold text-white">R</span>
            <p class="mt-3 text-sm font-medium text-[var(--color-ink)]">Ask anything, or tap a preset.</p>
            <p class="mt-1 text-[13px] text-[var(--color-ink-soft)]">The reply streams in token-by-token; the panel on the right shows the raw protocol frames live.</p>
          </div>
        </div>
      </div>

      <%# suggestions (streamed data-* part) %>
      <div data-ai-stream-target="suggestions" class="flex shrink-0 flex-wrap gap-1.5 px-4 empty:hidden"></div>

      <%# composer (pinned to the bottom of the chat panel) %>
      <form class="shrink-0 border-t hairline p-3" data-action="submit->ai-stream#submit">
        <div class="flex items-end gap-2">
          <textarea data-ai-stream-target="input" rows="1" name="prompt"
                    class="field-input resize-none" placeholder="Ask the model something…"
                    data-action="keydown.enter->ai-stream#submit"></textarea>
          <button type="submit" data-ai-stream-target="send" class="btn btn-accent shrink-0">Send</button>
        </div>
        <div class="mt-2 flex flex-wrap gap-1.5">
          <% @presets.each do |p| %>
            <button type="button" data-preset="true"
                    data-action="ai-stream#preset"
                    data-prompt="<%= p[:prompt] %>" data-mode="<%= p[:mode] %>"
                    class="rounded-full border hairline bg-[var(--color-surface)] px-2.5 py-1 font-mono text-[11px] text-[var(--color-ink-soft)] transition hover:border-[var(--color-accent)] hover:text-[var(--color-ink)]">
              <%= p[:label] %>
            </button>
          <% end %>
        </div>
      </form>
    </section>

    <%# --- Live wire inspector ----------------------------------------- %>
    <section class="flex min-h-0 min-w-0 flex-col overflow-hidden rounded-2xl border hairline bg-[var(--color-cool-50)]">
      <div class="flex shrink-0 items-center justify-between gap-2 border-b hairline px-3 py-2">
        <p class="eyebrow !mb-0">Wire inspector — live protocol frames</p>
        <span class="font-mono text-[10px] text-[var(--color-ink-faint)]">Vercel AI SDK data-stream</span>
      </div>

      <div data-ai-stream-target="wire" class="min-h-0 flex-1 overflow-y-auto">
        <div data-wire-placeholder class="grid h-full place-items-center px-6 text-center font-mono text-[11px] leading-relaxed text-[var(--color-ink-faint)]">
          data: { "type": "…" }<br>frames stream here as the model responds
        </div>
      </div>

      <footer class="shrink-0 border-t hairline px-3 py-2 text-[11px] leading-relaxed text-[var(--color-ink-soft)]">
        Each row is one Server-Sent-Events frame — the exact JSON the AI SDK's
        <code class="font-mono text-[var(--color-ink)]">useChat()</code> consumes, encoded by
        <a href="https://github.com/tachyurgy/ai_stream" rel="noopener" class="font-medium text-[var(--color-accent)] hover:underline">ai_stream</a>.
        <a href="https://github.com/tachyurgy/levelbrook-hotwire-demo/tree/main/app/controllers/relay" rel="noopener" class="font-medium text-[var(--color-accent)] hover:underline">View the controller&nbsp;↗</a>
      </footer>
    </section>
  </div>
</div>
