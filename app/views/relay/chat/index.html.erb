<% content_for :title, "Relay — live LLM streaming over the AI SDK protocol" %>

<div class="mx-auto max-w-6xl px-5 py-8"
     data-controller="ai-stream"
     data-ai-stream-url-value="<%= relay_messages_path %>">

  <%# --- Header -------------------------------------------------------- %>
  <header class="flex flex-wrap items-start justify-between gap-3">
    <div class="max-w-2xl">
      <p class="eyebrow">ActionController::Live · ai_stream · Google Gemini</p>
      <h1 class="mt-1 font-display text-3xl font-extrabold tracking-tight">
        A live LLM, streamed into Rails over the <span class="text-[var(--color-accent)]">AI SDK protocol</span>
      </h1>
      <p class="mt-2 text-sm leading-relaxed text-[var(--color-ink-soft)]">
        Type a prompt. Rails calls Gemini, and every token is encoded by
        <a href="https://github.com/tachyurgy/ai_stream" class="font-medium text-[var(--color-accent)] hover:underline" rel="noopener">ai_stream</a>
        — Levelbrook's Ruby port of the Vercel AI SDK data-stream protocol — and pushed down a single
        Server-Sent-Events response. Watch the answer render <em>and</em> the raw protocol frames that carry it.
      </p>
    </div>
    <span class="inline-flex items-center gap-1.5 rounded-full border hairline bg-[var(--color-surface)] px-2.5 py-1 font-mono text-[11px] <%= @live ? "text-emerald-600" : "text-[var(--color-ink-faint)]" %>">
      <span class="h-1.5 w-1.5 rounded-full <%= @live ? "bg-emerald-500" : "bg-[var(--color-ink-faint)]" %>"></span>
      <%= @live ? "Gemini live" : "canned tokens (no key)" %>
    </span>
  </header>

  <div class="mt-7 grid gap-6 lg:grid-cols-2">

    <%# --- Chat column ------------------------------------------------- %>
    <section class="flex min-w-0 flex-col rounded-2xl border hairline bg-[var(--color-paper)]">
      <div data-ai-stream-target="transcript"
           class="flex-1 space-y-3 overflow-y-auto p-4" style="height: 26rem">
        <div data-ai-stream-target="empty" class="grid h-full place-items-center text-center">
          <div class="max-w-xs">
            <span class="grid mx-auto h-10 w-10 place-items-center rounded-xl bg-[var(--color-accent)] font-display text-lg font-extrabold text-white">R</span>
            <p class="mt-3 text-sm font-medium text-[var(--color-ink)]">Ask anything, or try a preset.</p>
            <p class="mt-1 text-[13px] text-[var(--color-ink-soft)]">The reply streams token-by-token; the panel on the right shows the wire protocol live.</p>
          </div>
        </div>
      </div>

      <%# suggestions (streamed data-* part) %>
      <div data-ai-stream-target="suggestions" class="flex flex-wrap gap-1.5 px-4 empty:hidden"></div>

      <%# composer %>
      <form class="border-t hairline p-3" data-action="submit->ai-stream#submit">
        <div class="flex items-end gap-2">
          <textarea data-ai-stream-target="input" rows="1" name="prompt"
                    class="field-input resize-none" placeholder="Ask the model something…"
                    data-action="keydown.enter->ai-stream#submit"></textarea>
          <button type="submit" data-ai-stream-target="send" class="btn btn-accent shrink-0">Send</button>
        </div>
        <div class="mt-2 flex flex-wrap gap-1.5">
          <% @presets.each do |p| %>
            <button type="button" data-preset="true"
                    data-action="ai-stream#preset"
                    data-prompt="<%= p[:prompt] %>" data-mode="<%= p[:mode] %>"
                    class="rounded-full border hairline bg-[var(--color-surface)] px-2.5 py-1 font-mono text-[11px] text-[var(--color-ink-soft)] transition hover:border-[var(--color-accent)] hover:text-[var(--color-ink)]">
              <%= p[:label] %>
            </button>
          <% end %>
        </div>
      </form>
    </section>

    <%# --- Inspector + applications ------------------------------------ %>
    <section class="min-w-0 space-y-6">
      <div>
        <p class="eyebrow mb-2">Wire inspector — live protocol frames</p>
        <div class="overflow-hidden rounded-2xl border hairline bg-[var(--color-cool-50)]">
          <div data-ai-stream-target="wire" class="overflow-y-auto" style="height: 16rem">
            <div class="grid h-full place-items-center px-6 text-center font-mono text-[11px] text-[var(--color-ink-faint)]">
              data: { "type": "…" }<br>frames stream here as the model responds
            </div>
          </div>
        </div>
        <%= technique_caption "Each row is one Server-Sent-Events frame the browser receives — the exact JSON the Vercel AI SDK's useChat() consumes. ai_stream encodes start / text-delta / tool-input / tool-output / data-* / finish parts; consecutive deltas collapse into one counted row." %>
      </div>

      <div>
        <p class="eyebrow mb-2">What you can build with this</p>
        <div class="grid gap-2 sm:grid-cols-2">
          <% @applications.each do |a| %>
            <div class="rounded-xl border hairline bg-[var(--color-surface)] p-3">
              <div class="flex items-center justify-between gap-2">
                <h3 class="text-[13px] font-semibold text-[var(--color-ink)]"><%= a[:title] %></h3>
              </div>
              <p class="mt-1 text-[12.5px] leading-relaxed text-[var(--color-ink-soft)]"><%= a[:body] %></p>
              <p class="mt-1.5 font-mono text-[10px] text-[var(--color-ink-faint)]"><%= a[:part] %></p>
            </div>
          <% end %>
        </div>
      </div>
    </section>
  </div>

  <%# --- How it works strip ------------------------------------------- %>
  <div class="mt-8 rounded-2xl border hairline bg-[var(--color-surface)] p-5">
    <p class="eyebrow mb-3">The whole controller</p>
    <pre class="overflow-x-auto rounded-lg bg-[var(--color-ink)] p-4 font-mono text-[12px] leading-relaxed text-[#e8e6df]"><code>class Relay::MessagesController &lt; ApplicationController
  include ActionController::Live

  def create
    AiStream::HEADERS.each { |k, v| response.headers[k] = v }
    response.headers["Content-Type"] = "text/event-stream"

    AiStream::Stream.new do |w|
      w.start
      id = w.text_start
      GeminiService.stream_text(prompt: params[:prompt]) do |delta|
        w.text_delta(delta, id: id)        # one SSE frame per token
      end
      w.text_end(id: id)
      w.finish
    end.each { |frame| response.stream.write(frame) }
  ensure
    response.stream.close
  end
end</code></pre>
    <p class="mt-3 text-[13px] text-[var(--color-ink-soft)]">
      That's the entire integration — no Node sidecar, no SPA. The same endpoint can back the AI SDK's
      <code class="font-mono text-[12px]">useChat()</code> and <code class="font-mono text-[12px]">useObject()</code> hooks directly.
      Source: <a href="https://github.com/tachyurgy/levelbrook-hotwire-demo/tree/main/app/controllers/relay" class="font-medium text-[var(--color-accent)] hover:underline" rel="noopener">app/controllers/relay</a>.
    </p>
  </div>
</div>
