<%#
  Slim application topbar: breadcrumb on the left, ⌘K + identity on the right.
  On mobile the sidebar collapses, so the section links live here as a scroll row.
%>
<header class="sticky top-0 z-30 flex h-14 items-center gap-4 border-b hairline bg-[var(--color-surface)]/90 px-4 backdrop-blur md:px-6">
  <%= link_to root_path, class: "grid h-7 w-7 shrink-0 place-items-center rounded-md bg-[var(--color-ink)] font-display text-sm font-extrabold text-white md:hidden", data: { turbo_action: "advance" } do %>L<% end %>

  <nav class="hidden items-center gap-2 text-sm md:flex" aria-label="Breadcrumb">
    <span class="text-[var(--color-ink-faint)]">Workspace</span>
    <span class="text-[var(--color-ink-faint)]">/</span>
    <span class="font-semibold text-[var(--color-ink)]"><%= content_for?(:breadcrumb) ? yield(:breadcrumb) : section_title %></span>
  </nav>

  <nav class="flex items-center gap-1 overflow-x-auto md:hidden" aria-label="Sections">
    <% [["Dashboard", root_path, :pages], ["Board", projects_path, [:projects, :issues]],
        ["Room", channels_path, [:channels, :messages]], ["Search", search_path, :search],
        ["Activity", activities_path, :activities], ["Intake", new_signup_path, :signups]].each do |label, path, ctrls| %>
      <%= link_to label, path, data: { turbo_action: "advance" },
            class: "shrink-0 rounded-md px-2.5 py-1.5 text-sm font-medium transition #{nav_active?(ctrls) ? 'bg-[var(--color-cool-100)] text-[var(--color-ink)]' : 'text-[var(--color-ink-soft)]'}" %>
    <% end %>
  </nav>

  <div class="ml-auto flex items-center gap-3">
    <button type="button"
            onclick="window.dispatchEvent(new CustomEvent('command-palette:open'))"
            class="hidden items-center gap-2 rounded-md border hairline bg-[var(--color-cool-50)] px-2.5 py-1.5 text-sm text-[var(--color-ink-faint)] transition hover:text-[var(--color-ink)] sm:flex">
      <%= ws_icon("search", cls: "h-3.5 w-3.5") %>
      <span>Search anything</span>
      <span class="kbd">⌘K</span>
    </button>

    <% if current_member %>
      <%= render "shared/avatar", member: current_member, size: :md %>
    <% end %>
  </div>
</header>
