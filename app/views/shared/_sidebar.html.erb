<%#
  Persistent product chrome: a Linear/Jira-style left rail. It morphs on Turbo
  navigation (not data-turbo-permanent) so the active item stays in sync, while
  the media player below it owns its own permanence.
%>
<aside class="hidden w-60 shrink-0 flex-col border-r hairline bg-[var(--color-cool-50)] md:flex">
  <%= link_to root_path, class: "flex h-14 items-center gap-2.5 border-b hairline px-4", data: { turbo_action: "advance" } do %>
    <span class="grid h-7 w-7 place-items-center rounded-md bg-[var(--color-ink)] font-display text-sm font-extrabold text-white">L</span>
    <span>
      <span class="block font-display text-[14px] font-bold leading-none tracking-tight">Levelbrook</span>
      <span class="eyebrow mt-1 block">Delivery workspace</span>
    </span>
  <% end %>

  <nav class="flex-1 space-y-6 overflow-y-auto px-3 py-5">
    <% sections = {
         "Plan" => [
           ["Dashboard", root_path,        "dashboard", nav_active?(:pages)],
           ["Board",     projects_path,    "board",     nav_active?(:projects, :issues)],
           ["Search",    search_path,      "search",    nav_active?(:search)]
         ],
         "Team" => [
           ["Team room", channels_path,    "chat",      nav_active?(:channels, :messages)],
           ["Activity",  activities_path,  "activity",  nav_active?(:activities)]
         ],
         "Intake" => [
           ["New lead",  new_signup_path,  "inbox",     nav_active?(:signups)]
         ]
       } %>
    <% sections.each do |heading, items| %>
      <div>
        <p class="eyebrow mb-1.5 px-2"><%= heading %></p>
        <div class="space-y-0.5">
          <% items.each do |label, path, icon, active| %>
            <%= link_to path, data: { turbo_action: "advance" },
                  class: "flex items-center gap-2.5 rounded-md px-2.5 py-1.5 text-sm font-medium transition #{active ? 'bg-[var(--color-surface)] text-[var(--color-ink)] shadow-sm ring-1 ring-[var(--color-hairline)]' : 'text-[var(--color-ink-soft)] hover:bg-[var(--color-cool-100)] hover:text-[var(--color-ink)]'}" do %>
              <span class="<%= active ? 'text-[var(--color-accent)]' : 'text-[var(--color-ink-faint)]' %>"><%= ws_icon(icon) %></span>
              <%= label %>
            <% end %>
          <% end %>
        </div>
      </div>
    <% end %>

    <div>
      <p class="eyebrow mb-1.5 px-2">Projects</p>
      <div class="space-y-0.5">
        <% Project.order(:id).each do |project| %>
          <%= link_to project_path(project), data: { turbo_action: "advance" },
                class: "flex items-center gap-2.5 rounded-md px-2.5 py-1.5 text-sm text-[var(--color-ink-soft)] transition hover:bg-[var(--color-cool-100)] hover:text-[var(--color-ink)]" do %>
            <span class="font-mono text-[10px] font-semibold text-[var(--color-ink-faint)]"><%= project.key %></span>
            <span class="truncate"><%= project.name %></span>
          <% end %>
        <% end %>
      </div>
    </div>
  </nav>

  <div class="border-t hairline p-3">
    <% if current_member %>
      <div class="flex items-center gap-2.5 rounded-md px-1.5 py-1">
        <%= render "shared/avatar", member: current_member, size: :md %>
        <div class="min-w-0">
          <div class="truncate text-sm font-semibold leading-tight"><%= current_member.name %></div>
          <div class="truncate font-mono text-[10px] text-[var(--color-ink-faint)]"><%= current_member.role %></div>
        </div>
      </div>
    <% end %>
  </div>
</aside>
