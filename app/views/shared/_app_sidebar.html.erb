<%#
  Themed product left-rail. Re-skins per app via the accent override on the
  shell wrapper. The rail morphs on Turbo navigation (not data-turbo-permanent)
  so the active item stays in sync. `app` local = the current Showcase::App.
%>
<aside class="hidden w-60 shrink-0 flex-col border-r hairline bg-[var(--color-cool-50)] md:flex">
  <%# Header: app identity; click returns to the switcher. %>
  <%= link_to root_path, class: "flex h-14 items-center gap-2.5 border-b hairline px-4", data: { turbo_action: "advance" } do %>
    <span class="grid h-7 w-7 place-items-center rounded-md font-display text-sm font-extrabold text-white" style="background: var(--color-accent)"><%= app.glyph %></span>
    <span>
      <span class="block font-display text-[14px] font-bold leading-none tracking-tight"><%= app.name %></span>
      <span class="eyebrow mt-1 block"><%= app.domain %></span>
    </span>
  <% end %>

  <nav class="flex-1 space-y-6 overflow-y-auto px-3 py-5">
    <% case app.key %>
    <% when :workspace %>
      <div>
        <p class="eyebrow mb-1.5 px-2">Plan</p>
        <div class="space-y-0.5">
          <%= shell_nav_link "Dashboard", workspace_path, icon: "dashboard", active: nav_active?(:pages) %>
          <%= shell_nav_link "Board", projects_path, icon: "board", active: nav_active?(:projects, :issues) %>
          <%= shell_nav_link "Activity", activities_path, icon: "activity", active: nav_active?(:activities) %>
        </div>
      </div>
      <div>
        <p class="eyebrow mb-1.5 px-2">Intake</p>
        <div class="space-y-0.5">
          <%= shell_nav_link "New lead", new_signup_path, icon: "inbox", active: nav_active?(:signups) %>
        </div>
      </div>
      <div>
        <p class="eyebrow mb-1.5 px-2">Projects</p>
        <div class="space-y-0.5">
          <% Project.order(:id).each do |project| %>
            <%= link_to project_path(project), data: { turbo_action: "advance" },
                  class: "flex items-center gap-2.5 rounded-md px-2.5 py-1.5 text-sm text-[var(--color-ink-soft)] transition hover:bg-[var(--color-cool-100)] hover:text-[var(--color-ink)]" do %>
              <span class="font-mono text-[10px] font-semibold text-[var(--color-ink-faint)]"><%= project.key %></span>
              <span class="truncate"><%= project.name %></span>
            <% end %>
          <% end %>
        </div>
      </div>

    <% when :cadence %>
      <%# Channel switching swaps only the conversation frame, so this rail never
          re-renders. active-nav keeps the matching link flagged aria-current as
          the URL changes, and warms each channel up front so clicks land fast. %>
      <div data-controller="active-nav">
        <p class="eyebrow mb-1.5 px-2">Channels</p>
        <div class="space-y-0.5">
          <% Channel.order(:id).each do |channel| %>
            <%= link_to channel_path(channel),
                  data: { turbo_frame: "conversation", turbo_action: "advance", active_nav_target: "link" },
                  "aria-current": (defined?(@channel) && @channel == channel ? "page" : nil),
                  class: "group flex items-center gap-2.5 rounded-md px-2.5 py-1.5 text-sm font-medium text-[var(--color-ink-soft)] transition hover:bg-[var(--color-cool-100)] hover:text-[var(--color-ink)] aria-[current=page]:bg-[var(--color-surface)] aria-[current=page]:text-[var(--color-ink)] aria-[current=page]:shadow-sm aria-[current=page]:ring-1 aria-[current=page]:ring-[var(--color-hairline)]" do %>
              <span class="text-[var(--color-ink-faint)] group-aria-[current=page]:text-[var(--color-accent)]"><%= ws_icon "hash" %></span>
              <span class="truncate"><%= channel.name %></span>
            <% end %>
          <% end %>
        </div>
      </div>

    <% when :pulse %>
      <div>
        <p class="eyebrow mb-1.5 px-2">Operations</p>
        <div class="space-y-0.5">
          <%= shell_nav_link "Overview", pulse_root_path, icon: "gauge", active: true %>
        </div>
      </div>

    <% when :ballot %>
      <div>
        <p class="eyebrow mb-1.5 px-2">Live rooms</p>
        <div class="space-y-0.5">
          <% Ballot::Room.order(:id).each do |room| %>
            <%= shell_nav_link room.name, ballot_room_path(room), icon: "poll",
                  active: defined?(@room) && @room == room %>
          <% end %>
        </div>
      </div>

    <% when :grid %>
      <div>
        <p class="eyebrow mb-1.5 px-2">Sheets</p>
        <div class="space-y-0.5">
          <% Grid::Sheet.order(:id).each do |sheet| %>
            <%= shell_nav_link sheet.name, grid_sheet_path(sheet), icon: "grid",
                  active: defined?(@sheet) && @sheet == sheet %>
          <% end %>
        </div>
      </div>

    <% when :spindle %>
      <div>
        <p class="eyebrow mb-1.5 px-2">Library</p>
        <div class="space-y-0.5">
          <%= shell_nav_link "All albums", spindle_root_path, icon: "music", active: nav_active?(:albums) %>
        </div>
      </div>
    <% end %>
  </nav>

  <div class="border-t hairline p-3 space-y-2">
    <%= link_to root_path, data: { turbo_action: "advance" },
          class: "flex items-center gap-2 rounded-md px-2 py-1.5 text-xs font-medium text-[var(--color-ink-faint)] transition hover:bg-[var(--color-cool-100)] hover:text-[var(--color-ink)]" do %>
      <%= ws_icon "dashboard", cls: "h-3.5 w-3.5" %> All demos
    <% end %>
    <% if current_member %>
      <div class="flex items-center gap-2.5 rounded-md px-1.5 py-1">
        <%= render "shared/avatar", member: current_member, size: :md %>
        <div class="min-w-0">
          <div class="truncate text-sm font-semibold leading-tight"><%= current_member.name %></div>
          <div class="truncate font-mono text-[10px] text-[var(--color-ink-faint)]"><%= current_member.role %></div>
        </div>
      </div>
    <% end %>
  </div>
</aside>
