<%#
  Persistent ambient media player. It lives in the layout (not any view) and is
  data-turbo-permanent, so it survives every Turbo navigation/morph and keeps
  playing without re-mounting or re-muting. Audio is decoded once into a Web
  Audio buffer and looped sample-accurately (no MP3-padding gap); a GainNode
  fades smoothly in/out so there is never an abrupt cutout.
%>
<div id="player"
     data-turbo-permanent
     data-controller="player"
     data-player-src-value="<%= asset_path('ambient-loop.mp3') %>"
     class="fixed inset-x-0 bottom-0 z-40 border-t hairline bg-[var(--color-surface)]/95 backdrop-blur">
  <div class="mx-auto flex h-14 max-w-[1400px] items-center gap-4 px-5">
    <button type="button" data-action="player#toggle" data-player-target="toggle"
            class="grid h-9 w-9 shrink-0 place-items-center rounded-full bg-[var(--color-ink)] text-white transition hover:scale-105"
            aria-label="Play ambient focus track">
      <svg data-player-target="playIcon" class="h-4 w-4 translate-x-px" viewBox="0 0 16 16" fill="currentColor"><path d="M4 2.5v11l9-5.5z"/></svg>
      <svg data-player-target="pauseIcon" class="hidden h-4 w-4" viewBox="0 0 16 16" fill="currentColor"><path d="M4 2.5h3v11H4zM9 2.5h3v11H9z"/></svg>
    </button>

    <div class="min-w-0">
      <div class="truncate text-sm font-medium leading-tight">Deep Focus — Ambient Loop</div>
      <div class="eyebrow leading-tight">Persistent · keeps playing across views</div>
    </div>

    <%# Animated equalizer bars, active only while playing %>
    <div data-player-target="viz" class="ml-2 hidden items-end gap-0.5 sm:flex" style="height:18px">
      <% [0,1,2,3,4].each do |i| %>
        <span class="w-0.5 rounded-full bg-[var(--color-accent)]" style="height:<%= [6,12,18,10,14][i] %>px; animation: eq 900ms <%= i*120 %>ms ease-in-out infinite alternate"></span>
      <% end %>
    </div>

    <div class="ml-auto flex items-center gap-2">
      <span class="kbd hidden md:inline">data-turbo-permanent</span>
      <input type="range" min="0" max="100" value="60"
             data-action="input->player#volume" data-player-target="volume"
             class="h-1 w-24 cursor-pointer accent-[var(--color-accent)]">
    </div>
  </div>
</div>

<style>
  @keyframes eq { from { transform: scaleY(0.4); } to { transform: scaleY(1); } }
</style>
