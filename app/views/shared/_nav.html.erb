<header class="sticky top-0 z-30 border-b hairline bg-[var(--color-surface)]/90 backdrop-blur">
  <div class="mx-auto flex h-14 max-w-[1400px] items-center gap-6 px-5">
    <%= link_to root_path, class: "flex items-center gap-2.5 shrink-0", data: { turbo_action: "advance" } do %>
      <span class="grid h-7 w-7 place-items-center rounded-md bg-[var(--color-ink)] font-display text-sm font-extrabold text-white">L</span>
      <span class="font-display text-[15px] font-bold tracking-tight">Levelbrook</span>
      <span class="hidden sm:inline eyebrow translate-y-px">Workspace</span>
    <% end %>

    <nav class="hidden items-center gap-1 md:flex">
      <% nav_items = [
           ["Boards", projects_path],
           ["Chat", channels_path],
           ["Search", search_path],
           ["Activity", activities_path],
           ["Sign-up", new_signup_path]
         ] %>
      <% nav_items.each do |label, path| %>
        <%= link_to label, path,
              class: "rounded-md px-3 py-1.5 text-sm font-medium text-[var(--color-ink-soft)] transition hover:bg-[var(--color-cool-100)] hover:text-[var(--color-ink)] #{'bg-[var(--color-cool-100)] text-[var(--color-ink)]' if current_page?(path)}",
              data: { turbo_action: "advance" } %>
      <% end %>
    </nav>

    <div class="ml-auto flex items-center gap-3">
      <button type="button"
              onclick="window.dispatchEvent(new CustomEvent('command-palette:open'))"
              class="hidden items-center gap-2 rounded-md border hairline bg-[var(--color-cool-50)] px-2.5 py-1.5 text-sm text-[var(--color-ink-faint)] transition hover:text-[var(--color-ink)] sm:flex">
        <span>Search anything</span>
        <span class="kbd">⌘K</span>
      </button>

      <% if current_member %>
        <div class="flex items-center gap-2">
          <%= render "shared/avatar", member: current_member, size: :md %>
          <span class="hidden text-sm font-medium lg:inline"><%= current_member.name %></span>
        </div>
      <% end %>
    </div>
  </div>
</header>
