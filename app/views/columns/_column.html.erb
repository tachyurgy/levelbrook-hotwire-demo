<%# A single kanban column. The inner .column-cards list is the SortableJS drop %>
<%# zone; data-column-id tells the controller where a dropped card landed. %>
<% accent = { "To Do" => "bg-cool-300", "In Progress" => "bg-amber-400", "In Review" => "bg-violet-400", "Done" => "bg-emerald-400" }.fetch(column.name, "bg-cool-300") %>
<section id="<%= dom_id(column) %>" class="flex w-72 shrink-0 flex-col">
  <header class="mb-2 flex items-center gap-2 px-1">
    <span class="h-2 w-2 rounded-full <%= accent %>"></span>
    <h3 class="text-sm font-semibold tracking-tight"><%= column.name %></h3>
    <span class="font-mono text-[11px] text-[var(--color-ink-faint)]"><%= column.issues.size %></span>
    <% if column.wip_limit %>
      <span class="ml-auto kbd <%= 'border-[var(--color-accent)] text-[var(--color-accent)]' if column.over_wip_limit? %>" title="Work-in-progress limit">WIP <%= column.issues.size %>/<%= column.wip_limit %></span>
    <% end %>
  </header>

  <div data-controller="sortable"
       data-sortable-group-value="board"
       data-column-id="<%= column.id %>"
       class="column-cards flex min-h-24 flex-1 flex-col gap-2 rounded-xl bg-[var(--color-cool-100)]/60 p-2">
    <% column.issues.each do |issue| %>
      <%= render "issues/card", issue: issue %>
    <% end %>
  </div>
</section>
