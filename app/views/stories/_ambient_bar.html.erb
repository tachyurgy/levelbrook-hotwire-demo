<%#
  Persistent bottom bar. The id + data-turbo-permanent tell Turbo to preserve
  this exact element across every scene navigation — the audio context and the
  Stimulus controller's state are never torn down, so ambient sound plays
  continuously while the page morphs between scenes.
%>
<div id="ambient-bar" data-turbo-permanent
     data-controller="ambient-audio"
     class="fixed inset-x-0 bottom-0 z-40 border-t border-white/10 bg-slate-950/90 backdrop-blur">
  <div class="mx-auto flex max-w-2xl items-center gap-4 px-5 py-3">
    <button type="button"
            data-action="ambient-audio#toggle"
            data-ambient-audio-target="button"
            class="flex h-9 w-9 shrink-0 items-center justify-center rounded-full border border-white/15 bg-white/5 text-slate-300 transition hover:bg-white/10"
            aria-label="Toggle ambient sound">
      <span data-ambient-audio-target="icon">♪</span>
    </button>

    <div class="min-w-0 flex-1">
      <p class="text-xs font-medium text-slate-300">Ambient drone</p>
      <p data-ambient-audio-target="status" class="text-[11px] text-slate-500">Muted — tap to play</p>
    </div>

    <%# A small live-region cue that this bar is the same element across scenes. %>
    <span class="hidden text-[10px] uppercase tracking-wide text-slate-600 sm:inline">persists across scenes</span>
  </div>
</div>
