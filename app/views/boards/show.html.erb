<% content_for :title, "Collaborative Kanban — Levelbrook Hotwire Demos" %>

<%# Subscribe to the board's refresh stream. Any commit on the board (or a %>
<%# touched column/card) broadcasts a <turbo-stream action="refresh">; this %>
<%# browser re-fetches and morphs. This one line is the entire realtime wiring. %>
<%= turbo_stream_from @board %>

<div class="mx-auto max-w-6xl px-5 py-8">
  <div class="flex flex-wrap items-end justify-between gap-4">
    <div>
      <p class="text-xs font-semibold uppercase tracking-[0.15em] text-sky-400">Demo 1 · Multiplayer</p>
      <h1 class="mt-1 text-3xl font-bold tracking-tight text-white"><%= @board.name %></h1>
      <p class="mt-1 max-w-2xl text-sm text-slate-400"><%= @board.description %></p>
    </div>
    <div class="flex items-center gap-3">
      <%# Presence badge — replaced live by the PresenceChannel broadcast. %>
      <div data-controller="presence" data-presence-board-id-value="<%= @board.id %>">
        <%= render "boards/presence", count: 1 %>
      </div>
      <%= button_to "Reset board", reset_board_path, method: :post,
            class: "rounded-lg border border-white/10 bg-white/5 px-3 py-1.5 text-sm font-medium text-slate-300 transition hover:bg-white/10",
            form: { data: { turbo_confirm: "Reset the shared board to its starting state for everyone?" } } %>
    </div>
  </div>

  <div class="mt-6 grid gap-6 lg:grid-cols-[1fr_360px]">
    <%# Main, interactive board. %>
    <div class="rounded-2xl border border-white/10 bg-slate-900/40 p-4">
      <%= render "boards/board", board: @board, interactive: true %>
    </div>

    <%# Side-by-side live mirror: the SAME board, in an iframe. Move a card on %>
    <%# the left and watch it morph here with no page reload. %>
    <aside class="flex flex-col rounded-2xl border border-white/10 bg-slate-900/40 p-4">
      <div class="mb-3 flex items-center gap-2 text-xs font-medium text-slate-400">
        <span class="relative flex h-2 w-2">
          <span class="absolute inline-flex h-full w-full animate-ping rounded-full bg-emerald-400 opacity-75"></span>
          <span class="relative inline-flex h-2 w-2 rounded-full bg-emerald-500"></span>
        </span>
        Live mirror · a second browser, same board
      </div>
      <iframe src="<%= embed_board_path %>" title="Live mirror of the board"
              class="h-[560px] w-full rounded-lg border border-white/10 bg-slate-950"
              loading="lazy"></iframe>
      <p class="mt-3 text-xs leading-relaxed text-slate-500">
        Drag a card on the left. This pane is an independent browser session —
        it updates via <code>broadcasts_refreshes</code> + DOM morphing, no custom JS.
      </p>
    </aside>
  </div>
</div>
