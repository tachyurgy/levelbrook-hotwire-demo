<%#
  The board is one drag_and_drop controller. Columns are drop "containers";
  cards are draggable "items". On drop, the controller optimistically moves the
  card in the DOM, then POSTs the move to the server, which renumbers positions
  and broadcasts a refresh that morphs every connected browser into agreement.
%>
<div id="<%= dom_id(board) %>"
     class="grid grid-cols-1 gap-4 sm:grid-cols-2 xl:grid-cols-4"
     data-controller="drag-and-drop"
     data-drag-and-drop-dragging-class="opacity-40"
     data-drag-and-drop-over-class="ring-2 ring-sky-400/60">
  <% board.columns.each do |column| %>
    <%= render "columns/column", column: column %>
  <% end %>
</div>
