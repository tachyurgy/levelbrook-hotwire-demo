<% content_for :title, "Spindle — Library" %>

<div class="mx-auto max-w-6xl px-5 py-8 pb-24">
  <p class="eyebrow">Library · the player keeps going as you browse</p>
  <h1 class="mt-1 font-display text-3xl font-extrabold tracking-tight">Spindle</h1>
  <p class="mt-1.5 max-w-2xl text-sm text-[var(--color-ink-soft)]">
    Press play on any track, then move between albums — the bar at the bottom is <code class="font-mono text-[12px]">data-turbo-permanent</code>,
    so it survives every navigation and never cuts out.
  </p>

  <%# The honest framing: two of these albums have NO audio files at all. %>
  <div class="mt-6 grid gap-3 rounded-2xl border hairline bg-[var(--color-cool-50)] p-5 sm:grid-cols-2">
    <div>
      <p class="flex items-center gap-2 text-sm font-semibold text-[var(--color-ink)]">
        <span class="text-[var(--color-accent)]">♪</span> Two albums are synthesized live
      </p>
      <p class="mt-1 text-[13px] leading-relaxed text-[var(--color-ink-soft)]">
        <strong>Night Shipping</strong> and <strong>Broadcast Drift</strong> ship <em>zero</em> audio files.
        Every note is generated in real time in your browser by the Web Audio API — a lookahead scheduler,
        detuned voices, an FM electric-piano, and a convolution reverb, all in ~260 lines of JS.
        It's a demo of the <em>engine</em>, so judge the wiring, not the fidelity.
      </p>
    </div>
    <div>
      <p class="flex items-center gap-2 text-sm font-semibold text-[var(--color-ink)]">
        <span class="text-emerald-600">●</span> Two albums stream real CC0 audio
      </p>
      <p class="mt-1 text-[13px] leading-relaxed text-[var(--color-ink-soft)]">
        <strong>Public Domain Tape</strong> and <strong>Free Signal</strong> stream genuine
        public-domain (CC0) recordings through the <em>same</em> persistent player — proving the
        graph handles a synthesized source and a streamed file identically. No attribution required.
      </p>
    </div>
  </div>

  <div class="mt-8 grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
    <% @albums.each do |album| %>
      <%= link_to spindle_album_path(album), data: { turbo_action: "advance" },
            class: "group overflow-hidden rounded-2xl border hairline bg-[var(--color-surface)] transition hover:-translate-y-0.5 hover:shadow-xl" do %>
        <div class="relative aspect-[16/10] w-full" style="view-transition-name: album-<%= album.slug %>; background: linear-gradient(135deg, <%= album.hue %>, color-mix(in srgb, <%= album.hue %> 40%, #14171a))">
          <div class="absolute right-3 top-3"><%= spindle_mode_badge(album) %></div>
          <div class="flex h-full items-end p-4">
            <span class="font-display text-2xl font-extrabold text-white drop-shadow"><%= album.title %></span>
          </div>
        </div>
        <div class="p-4">
          <p class="font-mono text-[11px] text-[var(--color-ink-faint)]"><%= album.artist %></p>
          <p class="mt-0.5 text-sm text-[var(--color-ink-soft)]"><%= album.mood %></p>
          <p class="mt-2 font-mono text-[10px] text-[var(--color-ink-faint)]"><%= pluralize(album.tracks.size, "track") %></p>
        </div>
      <% end %>
    <% end %>
  </div>
</div>
