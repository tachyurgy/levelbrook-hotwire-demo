<% content_for :title, "##{@channel.name} — Cadence" %>

<%# Switching channels only swaps THIS frame — the rail, topbar and player stay
    mounted, so there's no full-document teardown or cable churn on the shell.
    Frame requests skip the layout (ChannelsController), so the response is just
    the conversation; with Turbo's hover prefetch it lands instantly. %>
<%= turbo_frame_tag "conversation", class: "block", data: { turbo_action: "advance" } do %>
<%# Conversation. The channel list lives in the app rail; this is full-width. %>
<section class="mx-auto flex h-[calc(100vh-3.5rem)] max-w-4xl flex-col px-5"
         data-controller="chat presence typing"
         data-presence-slug-value="<%= @channel.slug %>"
         data-typing-slug-value="<%= @channel.slug %>"
         data-typing-name-value="<%= current_member&.name %>">
  <header class="flex items-center justify-between border-b hairline px-1 py-3">
    <div>
      <h1 class="font-display text-lg font-bold tracking-tight"># <%= @channel.name %></h1>
      <p class="text-xs text-[var(--color-ink-soft)]"><%= @channel.topic %></p>
    </div>
    <%# Presence roster — populated live over Action Cable. %>
    <div class="flex items-center gap-2">
      <span class="eyebrow">Online</span>
      <div data-presence-target="roster" class="flex items-center gap-1.5"></div>
    </div>
  </header>

  <%# Live message feed. New messages stream-append here for every subscriber. %>
  <%= turbo_stream_from @channel %>
  <div data-chat-target="scroll" class="flex-1 overflow-y-auto py-3">
    <div id="messages">
      <% @messages.each do |message| %>
        <%= render "messages/message", message: message %>
      <% end %>
    </div>
  </div>

  <%# Typing indicator %>
  <div class="h-5 px-1">
    <span data-typing-target="indicator" class="hidden font-mono text-[11px] text-[var(--color-ink-faint)]">
      <span data-typing-target="author"></span> is typing…
    </span>
  </div>

  <footer class="border-t hairline py-3">
    <%= render "messages/form", channel: @channel %>
    <%= technique_caption "Messages append via broadcast_append_to; reactions broadcast_replace just one message; presence + typing ride raw Action Cable channels — not DOM over the wire." %>
  </footer>
</section>
<% end %>
