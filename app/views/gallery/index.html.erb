<% content_for :title, "Levelbrook · Hotwire Showcase" %>

<div class="min-h-full bg-[var(--color-paper)]">
  <div class="mx-auto max-w-6xl px-5 py-16 sm:py-24">

    <%# --- Hero -------------------------------------------------------- %>
    <header class="max-w-3xl">
      <div class="flex items-center gap-2.5">
        <span class="grid h-8 w-8 place-items-center rounded-lg bg-[var(--color-ink)] font-display text-base font-extrabold text-white">L</span>
        <span class="eyebrow">Levelbrook Consulting · Hotwire practice</span>
      </div>
      <h1 class="mt-6 font-display text-4xl font-extrabold leading-[1.05] tracking-tight sm:text-6xl">
        Six real apps.<br>One Rails codebase.<br><span class="text-[var(--color-accent)]">Zero SPA.</span>
      </h1>
      <p class="mt-5 max-w-2xl text-lg leading-relaxed text-[var(--color-ink-soft)]">
        Each demo below is a distinct, production-shaped product built on Rails&nbsp;8 + Hotwire —
        realtime collaboration, optimistic UI, server-rendered dashboards, spreadsheet-grade inline
        editing, and media that never stops. Pick one and open it; the working software comes first,
        the technique notes come after.
      </p>
      <div class="mt-6 flex flex-wrap items-center gap-x-5 gap-y-2 font-mono text-[11px] text-[var(--color-ink-faint)]">
        <span>Rails 8.1</span><span>·</span><span>Turbo 8 morphing</span><span>·</span>
        <span>Stimulus</span><span>·</span><span>Action Cable</span><span>·</span>
        <span>Solid Queue / Cable</span><span>·</span><span>Tailwind v4</span>
      </div>
    </header>

    <%# --- App grid ---------------------------------------------------- %>
    <div class="mt-14 grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
      <% @apps.each do |app| %>
        <%= link_to app_entry_path(app), data: { turbo_action: "advance" },
              class: "group relative flex flex-col overflow-hidden rounded-2xl border hairline bg-[var(--color-surface)] p-6 transition hover:-translate-y-0.5 hover:shadow-xl",
              style: "--color-accent: #{app.accent}; --color-accent-soft: #{app.accent_soft};" do %>
          <%# Accent wash %>
          <span class="pointer-events-none absolute inset-x-0 top-0 h-1" style="background: <%= app.accent %>"></span>

          <div class="flex items-start justify-between">
            <span class="grid h-12 w-12 place-items-center rounded-xl font-display text-xl font-extrabold text-white shadow-sm" style="background: <%= app.accent %>"><%= app.glyph %></span>
            <span class="rounded-full border hairline px-2.5 py-1 font-mono text-[10px] uppercase tracking-wider text-[var(--color-ink-faint)]"><%= app.domain %></span>
          </div>

          <h2 class="mt-5 font-display text-2xl font-bold tracking-tight">
            <%= app.name %>
          </h2>
          <p class="mt-1 text-sm leading-relaxed text-[var(--color-ink-soft)]"><%= app.tagline %></p>

          <div class="mt-4 flex flex-wrap gap-1.5">
            <% app.primitives.each do |p| %>
              <span class="rounded-full bg-[var(--color-cool-100)] px-2 py-0.5 font-mono text-[10px] text-[var(--color-ink-soft)]"><%= p %></span>
            <% end %>
          </div>

          <div class="mt-5 flex items-center justify-between border-t hairline pt-4">
            <span class="truncate font-mono text-[10px] text-[var(--color-ink-faint)]">
              mined from <%= app.repos.join(" · ") %>
            </span>
            <span class="ml-2 grid h-7 w-7 shrink-0 place-items-center rounded-full text-[var(--color-accent)] transition group-hover:translate-x-0.5" style="background: <%= app.accent_soft %>">→</span>
          </div>
        <% end %>
      <% end %>
    </div>

    <%# --- Footer ------------------------------------------------------ %>
    <footer class="mt-16 flex flex-col items-start justify-between gap-3 border-t hairline pt-6 text-[var(--color-ink-faint)] sm:flex-row sm:items-center">
      <p class="font-mono text-[11px]">
        Built by Levelbrook Consulting — senior Ruby on Rails staff augmentation.
      </p>
      <p class="font-mono text-[11px]">
        Every technique is repurposed from 35 studied open-source Hotwire repos.
      </p>
    </footer>
  </div>
</div>
