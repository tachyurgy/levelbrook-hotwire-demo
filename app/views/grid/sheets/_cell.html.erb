<%#
  An editable spreadsheet cell. Display + input live in the same node; clicking
  reveals the input instantly (inline-edit controller — no round-trip), and it
  auto-submits on change. The save touches the sheet so the formula cells morph.
  locals: row, field, type (:text | :number), align ("left" | "right")
%>
<% align ||= (type == :number ? "right" : "left") %>
<% value = row.public_send(field) %>
<div data-controller="inline-edit" class="relative">
  <button type="button" data-inline-edit-target="display" data-action="inline-edit#edit"
          class="block w-full cursor-cell px-3 py-2.5 text-sm text-<%= align %> tabular-nums transition hover:bg-[var(--color-accent-soft)] hover:ring-1 hover:ring-inset hover:ring-[var(--color-accent)]/40 focus:outline-none focus-visible:ring-2 focus-visible:ring-inset focus-visible:ring-[var(--color-accent)]">
    <% if type == :number && field == "unit_price" %>
      <%= number_to_currency(value, unit: row.sheet.unit, precision: 0) %>
    <% else %>
      <%= value %>
    <% end %>
  </button>

  <%= form_with url: grid_cell_path(row), method: :patch, data: { inline_edit_target: "form" }, class: "hidden" do |f| %>
    <%= hidden_field_tag :field, field %>
    <%# A plain text input — no type="number", so no up/down spinner stepper.
        Numeric cells get inputmode:numeric (mobile number pad); the server
        strips non-digits and validates. Esc reverts, blur closes the editor. %>
    <%= text_field_tag "row[#{field}]", value,
          inputmode: (type == :number ? "numeric" : nil),
          autocomplete: "off",
          onchange: "this.form.requestSubmit()",
          data: { inline_edit_target: "input",
                  action: "keydown.esc->inline-edit#cancel blur->inline-edit#cancel" },
          class: "field-input w-full px-3 py-2 text-sm text-#{align} tabular-nums" %>
  <% end %>
</div>
