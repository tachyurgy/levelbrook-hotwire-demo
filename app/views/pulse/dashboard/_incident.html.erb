<div id="<%= dom_id(incident) %>" class="rounded-xl border hairline bg-[var(--color-surface)] p-3 <%= 'opacity-60' if incident.resolved? %>">
  <div class="flex items-center justify-between gap-2">
    <span class="rounded px-1.5 py-0.5 font-mono text-[10px] font-semibold uppercase <%= incident.severity_style %>"><%= incident.severity %></span>
    <span class="font-mono text-[10px] text-[var(--color-ink-faint)]"><%= time_ago_in_words(incident.started_at) %> ago</span>
  </div>
  <p class="mt-2 text-[13px] font-medium leading-snug <%= 'line-through' if incident.resolved? %>"><%= incident.title %></p>
  <p class="mt-0.5 font-mono text-[10px] text-[var(--color-ink-faint)]"><%= incident.service&.name || "platform" %></p>

  <div class="mt-2.5 flex items-center gap-1.5">
    <% if incident.resolved? %>
      <span class="font-mono text-[10px] font-semibold text-emerald-600">✓ resolved</span>
    <% else %>
      <% if incident.status == "open" %>
        <%= button_to "Acknowledge", pulse_incident_path(incident, status: "ack"), method: :patch,
              class: "rounded-md border hairline px-2 py-1 text-[11px] font-medium text-[var(--color-ink-soft)] transition hover:text-[var(--color-ink)]" %>
      <% else %>
        <span class="rounded-md bg-amber-50 px-2 py-1 font-mono text-[10px] font-semibold text-amber-700">acknowledged</span>
      <% end %>
      <%= button_to "Resolve", pulse_incident_path(incident, status: "resolved"), method: :patch,
            class: "rounded-md px-2 py-1 text-[11px] font-medium text-white transition", style: "background: var(--color-accent)" %>
    <% end %>
  </div>
</div>
