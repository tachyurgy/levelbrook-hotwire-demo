<%= turbo_frame_tag :pulse_events do %>
  <div class="overflow-hidden rounded-xl border hairline bg-[var(--color-surface)]">
    <ul class="divide-y hairline">
      <% events.each do |event| %>
        <li class="flex items-center gap-3 px-4 py-2.5">
          <span class="font-mono text-[11px] text-[var(--color-ink-faint)] tabular-nums"><%= event[:at].strftime("%H:%M:%S") %></span>
          <span class="text-[13px] font-semibold"><%= event[:service] %></span>
          <span class="truncate font-mono text-[11px] text-[var(--color-ink-soft)]"><%= event[:text] %></span>
        </li>
      <% end %>
    </ul>
  </div>
<% end %>
