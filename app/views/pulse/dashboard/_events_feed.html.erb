<%# Streamed event feed (target: pulse_events). Replaced whole each tick with the
    latest traces/errors/deploys. locals: events %>
<div id="pulse_events" class="overflow-hidden rounded-xl border hairline bg-[var(--color-surface)]">
  <ul class="divide-y hairline">
    <% events.each do |event| %>
      <% es = pulse_event_style(event[:level]) %>
      <li class="flex items-center gap-3 px-4 py-2.5">
        <span class="h-1.5 w-1.5 shrink-0 rounded-full" style="background: <%= es[:dot] %>"></span>
        <span class="shrink-0 font-mono text-[11px] text-[var(--color-ink-faint)] tabular-nums"><%= Time.zone.at(event[:at]).strftime("%H:%M:%S") %></span>
        <span class="w-28 shrink-0 truncate text-[13px] font-semibold"><%= event[:service] %></span>
        <span class="truncate font-mono text-[11px] <%= es[:text] %>"><%= event[:text] %></span>
      </li>
    <% end %>
  </ul>
</div>
