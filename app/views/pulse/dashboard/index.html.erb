<% content_for :title, "Pulse — Live Ops" %>

<%# Subscribe once. Every metric, the chart, the service grid, the event feed and
    incident cards stream in over this channel as the always-on ticker produces
    samples — targeted Turbo Stream replaces, no page reload, no polling. %>
<%= turbo_stream_from Pulse::STREAM %>

<div class="mx-auto max-w-6xl px-5 py-8">
  <%# --- Header ---------------------------------------------------------- %>
  <div class="flex flex-wrap items-end justify-between gap-4">
    <div>
      <div class="flex items-center gap-2.5">
        <span class="relative flex h-2.5 w-2.5">
          <span class="absolute inline-flex h-full w-full animate-ping rounded-full bg-emerald-500 opacity-70"></span>
          <span class="relative inline-flex h-2.5 w-2.5 rounded-full bg-emerald-500"></span>
        </span>
        <p class="eyebrow text-emerald-600">Live · streaming over Action Cable</p>
      </div>
      <h1 class="mt-1 font-display text-3xl font-extrabold tracking-tight">Service health</h1>
      <p class="mt-1.5 text-sm text-[var(--color-ink-soft)]">
        Golden signals sampled every <%= Pulse::TICK %>s on the server and pushed the instant they land — server-rendered SVG, no charting library, no client polling.
      </p>
    </div>
    <%= button_to "Trigger incident", pulse_trigger_incident_path, class: "btn btn-ghost" %>
  </div>

  <%# --- Golden-signals chart + KPI tiles (streamed) -------------------- %>
  <%= render "pulse/dashboard/metrics", services: @services, timeline: @timeline, open_incidents: @open_incidents %>

  <%# --- Deploy widget (job -> streamed progress bar) ------------------- %>
  <div class="mt-4 rounded-xl border hairline bg-[var(--color-surface)] p-5">
    <div class="flex flex-wrap items-center justify-between gap-3">
      <div>
        <p class="eyebrow">Deploy a service</p>
        <p class="mt-0.5 text-sm text-[var(--color-ink-soft)]">An Active Job streams progress over Action Cable — watch it in a second tab.</p>
      </div>
      <%= form_with url: pulse_deploys_path, method: :post, class: "flex items-center gap-2" do |f| %>
        <%= f.select :service_id, @services_for_deploy.map { |s| [ s.name, s.id ] }, {},
              class: "field-input py-1.5 cursor-pointer" %>
        <%= f.submit "Run deploy", class: "btn btn-accent" %>
      <% end %>
    </div>
    <div class="mt-4">
      <%= render "pulse/dashboard/deploy_status", service: nil, pct: nil, done: false, active: false %>
    </div>
  </div>

  <%# --- Service grid + incidents -------------------------------------- %>
  <div class="mt-4 grid gap-4 lg:grid-cols-3">
    <div class="lg:col-span-2">
      <p class="eyebrow mb-3">Services</p>
      <%= render "pulse/dashboard/services", services: @services %>
      <%= technique_caption "Each card is a server-rendered SVG sparkline. As samples arrive the job broadcasts a replace — the line redraws, the page doesn't reload." %>
    </div>

    <div>
      <p class="eyebrow mb-3">Incidents</p>
      <div id="pulse_incidents" class="space-y-2.5">
        <% @incidents.each do |incident| %>
          <%= render "pulse/dashboard/incident", incident: incident %>
        <% end %>
      </div>
      <%= technique_caption "Acknowledge / resolve broadcast a targeted replace — instant in every open tab. (The classic Turbo gotcha: a broadcast_refresh is suppressed in the tab that triggered it; a targeted replace isn't.)" %>
    </div>
  </div>

  <%# --- Live event feed (streamed) ------------------------------------ %>
  <div class="mt-4">
    <div class="mb-3 flex items-center gap-2">
      <p class="eyebrow">Event stream</p>
      <span class="h-1.5 w-1.5 rounded-full bg-emerald-500"></span>
    </div>
    <%= render "pulse/dashboard/events_feed", events: @events %>
  </div>
</div>
