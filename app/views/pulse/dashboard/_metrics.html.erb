<%#
  The streamed metrics block (target: pulse_metrics). Pulse.broadcast_metrics
  replaces this whole node each tick — there is no per-element client state to
  preserve, so a single replace keeps the hero chart + every KPI tile in lockstep.
  locals: services, timeline, open_incidents
%>
<div id="pulse_metrics" class="mt-6 space-y-3">
  <% cur = timeline.last || { tp: 0, lat: 0, err: 0, apdex: 1.0 } %>
  <% tp  = pulse_timeseries(timeline, :tp,  width: 760, height: 200) %>
  <% lat = pulse_timeseries(timeline, :lat, width: 760, height: 200) %>
  <% d_tp = pulse_delta(timeline, :tp) %>

  <%# ---- Hero: throughput over time, latency overlaid ------------------ %>
  <div class="rounded-xl border hairline bg-[var(--color-surface)] p-5">
    <div class="flex flex-wrap items-start justify-between gap-3">
      <div>
        <p class="eyebrow">Throughput · requests / min</p>
        <div class="mt-1 flex items-baseline gap-2.5">
          <span class="font-display text-4xl font-extrabold leading-none tracking-tight tabular-nums"><%= number_with_delimiter(cur[:tp]) %></span>
          <% if d_tp %>
            <span class="font-mono text-xs font-semibold <%= d_tp[:good] ? 'text-emerald-600' : 'text-rose-600' %>">
              <%= d_tp[:dir] == :down ? "▼" : (d_tp[:dir] == :up ? "▲" : "▬") %> <%= d_tp[:text] %>
            </span>
          <% end %>
        </div>
      </div>
      <div class="flex items-center gap-4 font-mono text-[11px] text-[var(--color-ink-faint)]">
        <span class="flex items-center gap-1.5"><span class="h-2 w-2 rounded-sm" style="background: var(--color-accent)"></span>throughput</span>
        <span class="flex items-center gap-1.5"><span class="h-0.5 w-3.5 rounded-sm" style="background: #4f46e5"></span>avg latency</span>
        <span>last <%= timeline.size %> samples</span>
      </div>
    </div>

    <div class="relative mt-4">
      <svg viewBox="0 0 760 200" class="h-52 w-full" preserveAspectRatio="none">
        <%# gridlines %>
        <% tp[:grid].each do |g| %>
          <line x1="0" x2="760" y1="<%= g[:y] %>" y2="<%= g[:y] %>" stroke="var(--color-hairline)" stroke-width="1" stroke-dasharray="2 4"></line>
        <% end %>
        <%# throughput area + line %>
        <% if tp[:area].present? %>
          <polygon points="<%= tp[:area] %>" fill="var(--color-accent-soft)" opacity="0.65"></polygon>
          <polyline points="<%= tp[:line] %>" fill="none" stroke="var(--color-accent)" stroke-width="2" stroke-linejoin="round" stroke-linecap="round" vector-effect="non-scaling-stroke"></polyline>
        <% end %>
        <%# latency overlay (own scale) %>
        <% if lat[:line].present? %>
          <polyline points="<%= lat[:line] %>" fill="none" stroke="#4f46e5" stroke-width="1.5" stroke-linejoin="round" stroke-linecap="round" stroke-dasharray="1 0" opacity="0.85" vector-effect="non-scaling-stroke"></polyline>
        <% end %>
        <%# leading-edge "now" marker %>
        <% if tp[:last] %>
          <circle cx="<%= tp[:last][0] %>" cy="<%= tp[:last][1] %>" r="3.5" fill="var(--color-accent)"></circle>
        <% end %>
      </svg>
      <%# y-axis labels, overlaid (chart is full-bleed) %>
      <div class="pointer-events-none absolute inset-0">
        <% tp[:grid].each do |g| %>
          <span class="absolute left-0 -translate-y-1/2 bg-[var(--color-surface)] pr-1 font-mono text-[10px] text-[var(--color-ink-faint)] tabular-nums"
                style="top: <%= (g[:y] / 200.0 * 100).round(1) %>%"><%= number_with_delimiter(g[:value].round) %></span>
        <% end %>
      </div>
    </div>
    <div class="mt-1.5 flex justify-between font-mono text-[10px] text-[var(--color-ink-faint)]">
      <span>−<%= timeline.size %> samples</span>
      <span>now</span>
    </div>
  </div>

  <%# ---- KPI tiles ----------------------------------------------------- %>
  <div class="grid grid-cols-2 gap-3 lg:grid-cols-4">
    <%
      tiles = [
        { label: "Avg latency (p95)", key: :lat,   value: pulse_num(cur[:lat], :lat),   spark: timeline.map { |p| p[:lat] },   invert: true,  sub: "across healthy services" },
        { label: "Error rate",        key: :err,   value: pulse_num(cur[:err], :err),   spark: timeline.map { |p| p[:err] },   invert: true,  sub: "worst service" },
        { label: "Apdex",             key: :apdex, value: pulse_num(cur[:apdex], :apdex), spark: timeline.map { |p| p[:apdex] }, invert: false, sub: "T = 90ms" }
      ]
    %>
    <% tiles.each do |t| %>
      <% d = pulse_delta(timeline, t[:key], invert: t[:invert]) %>
      <% s = sparkline(t[:spark], width: 120, height: 28) %>
      <div class="rounded-xl border hairline bg-[var(--color-surface)] p-4">
        <p class="eyebrow"><%= t[:label] %></p>
        <div class="mt-2 flex items-end justify-between gap-2">
          <span class="font-display text-3xl font-extrabold leading-none tracking-tight tabular-nums"><%= t[:value] %></span>
          <svg viewBox="0 0 120 28" class="h-7 w-20 shrink-0" preserveAspectRatio="none">
            <% if s[:line].present? %>
              <polyline points="<%= s[:line] %>" fill="none" stroke="<%= t[:invert] ? '#4f46e5' : 'var(--color-accent)' %>" stroke-width="1.5" stroke-linejoin="round" vector-effect="non-scaling-stroke"></polyline>
            <% end %>
          </svg>
        </div>
        <div class="mt-1.5 flex items-center justify-between">
          <span class="font-mono text-[10px] text-[var(--color-ink-faint)]"><%= t[:sub] %></span>
          <% if d %>
            <span class="font-mono text-[10px] font-semibold <%= d[:good] ? 'text-emerald-600' : 'text-rose-600' %>">
              <%= d[:dir] == :down ? "▼" : (d[:dir] == :up ? "▲" : "▬") %> <%= d[:text] %>
            </span>
          <% end %>
        </div>
      </div>
    <% end %>

    <%# Open incidents tile %>
    <div class="rounded-xl border hairline bg-[var(--color-surface)] p-4">
      <p class="eyebrow">Open incidents</p>
      <div class="mt-2 flex items-end justify-between gap-2">
        <span class="font-display text-3xl font-extrabold leading-none tracking-tight tabular-nums <%= open_incidents.positive? ? 'text-rose-600' : '' %>"><%= open_incidents %></span>
        <span class="h-7 w-20 shrink-0"></span>
      </div>
      <p class="mt-1.5 font-mono text-[10px] text-[var(--color-ink-faint)]">
        <%= services.count { |s| s.status == "down" } %> down · <%= services.count { |s| s.status == "degraded" } %> degraded
      </p>
    </div>
  </div>
</div>
